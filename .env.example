# 发布凭证（本地文件，请勿提交到 git）
#
# ⚠️ 两条发布通道，门禁与校验完全一致（见 AGENTS.md §5）：
#   ① workbench（推荐，无需 SSH 私钥）：python scripts/upload-workbench.py
#      走阿里云云助手 API（文件经 OSS 中转），凭据在 workbench 自己的 profile 里。
#   ② SCP：python scripts/upload.py
#      需要服务器认得本机私钥（~/.ssh 或 SERVER_SSH_KEY 指定的文件）。
#
# ⚠️ 下面这套 FTP 凭据是**历史遗留**，指向另一个阿里云虚拟主机（v3.21.0 的老副本），
#    传到那里用户拿不到 —— 已作废，别再用它发布。

# 阿里云轻量服务器（发布目标）
SERVER_HOST=你的服务器地址
SERVER_USER=root
# ECS 实例 ID（workbench 通道用；从阿里云控制台或 workbench list 拿）
SERVER_INSTANCE_ID=你的ECS实例ID
# 部署目录：站点根下的 UserScripts/bilibili（脚本产物 + version.json + hot-config/ + www/ + api/）
SERVER_DEPLOY_PATH=/www/wwwroot/www.asifadeaway.com/UserScripts/bilibili
# 私钥路径（留空则用默认 ~/.ssh/id_ed25519）
# SERVER_SSH_KEY=C:/Users/你的用户名/.ssh/server_ed25519
# Gitee 镜像读取限额用（可选；个人 token 绝不能进用户脚本）
# GITEE_PERSONAL_TOKEN=

# —— 以下为废弃的 FTP 发布凭据（保留仅供追溯）——
# FTP_HOST=你的FTP地址
# FTP_USER=你的FTP用户名
# FTP_PASSWORD=你的FTP密码
